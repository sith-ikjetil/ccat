# .sql

# Comments
color green start="\/\*" end="\*\/"
color green "\-\-.*$"

# Keywords
icolor brightblue "(?i)\b(ALL|ASC|AS|ALTER|AND|ADD|AUTO_INCREMENT)\b"
icolor brightblue "(?i)\b(BETWEEN|BINARY|BOTH|BY|BOOLEAN)\b"
icolor brightblue "(?i)\b(CHANGE|CHECK|COLUMNS|COLUMN|CROSS|CREATE)\b"
icolor brightblue "(?i)\b(DATABASES|DATABASE|DATA|DELAYED|DESCRIBE|DESC|DISTINCT|DELETE|DROP|DEFAULT)\b"
icolor brightblue "(?i)\b(ENCLOSED|ESCAPED|EXISTS|EXPLAIN)\b"
icolor brightblue "(?i)\b(FIELDS|FIELD|FLUSH|FOR|FOREIGN|FUNCTION|FROM)\b"
icolor brightblue "(?i)\b(GROUP|GRANT|HAVING)\b"
icolor brightblue "(?i)\b(IGNORE|INDEX|INFILE|INSERT|INNER|INTO|IDENTIFIED|IN|IS|IF)\b"
icolor brightblue "(?i)\b(JOIN|KEYS|KILL|KEY)\b"
icolor brightblue "(?i)\b(LEADING|LIKE|LIMIT|LINES|LOAD|LOCAL|LOCK|LOW_PRIORITY|LEFT|LANGUAGE)\b"
icolor brightblue "(?i)\b(MODIFY|NATURAL|NOT|NULL|NEXTVAL)\b"
icolor brightblue "(?i)\b(OPTIMIZE|OPTION|OPTIONALLY|ORDER|OUTFILE|OR|OUTER|ON)\b"
icolor brightblue "(?i)\b(PROCEDURE|PROCEDURAL|PRIMARY)\b"
icolor brightblue "(?i)\b(READ|REFERENCES|REGEXP|RENAME|REPLACE|RETURN|REVOKE|RLIKE|RIGHT)\b"
icolor brightblue "(?i)\b(SHOW|SONAME|STATUS|STRAIGHT_JOIN|SELECT|SETVAL|SET)\b"
icolor brightblue "(?i)\b(TABLES|TERMINATED|TO|TRAILING|TRUNCATE|TABLE|TEMPORARY|TRIGGER|TRUSTED)\b"
icolor brightblue "(?i)\b(UNIQUE|UNLOCK|USE|USING|UPDATE|VALUES|VARIABLES|VIEW)\b"
icolor brightblue "(?i)\b(WITH|WRITE|WHERE|ZEROFILL|TYPE|XOR)\b"
color brightred "(?i)\b(VARCHAR|TINYINT|TEXT|DATE|SMALLINT|MEDIUMINT|INT|INTEGER|BIGINT|FLOAT|DOUBLE|DECIMAL|DATETIME|TIMESTAMP|TIME|YEAR|UNSIGNED|CHAR|TINYBLOB|TINYTEXT|BLOB|MEDIUMBLOB|MEDIUMTEXT|LONGBLOB|LONGTEXT|ENUM|BOOL|BINARY|VARBINARY)\b"

# SQLite meta commands
icolor brightblue "(?i)\.\<(databases|dump|echo|exit|explain|header(s)?|help)\>"
icolor brightblue "(?i)\.\<(import|indices|mode|nullvalue|output|prompt|quit|read)\>"
icolor brightblue "(?i)\.\<(schema|separator|show|tables|timeout|width)\>"
color brightcyan  "\<(ON|OFF)\>"

color brightred   "\<([0-9]+)\>"
color brightgreen ""(\\.|[^"])*"|'(\\.|[^'])*'"
color brightgreen   "`(\\.|[^\\`])*`"
color brightyellow "[\=\(\)\;\,\.\-]+"
