<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
	  <ComponentGroup Id="CCatComponents" Directory="INSTALLFOLDER64">
		  <Component Guid="{D4BD03A4-AFCA-4087-8EA6-B872EDE1B2E0}">
			  <File Id="CCatExe" Source="../../../src/ccat.exe" KeyPath="yes"/>
			  <Environment
					Id="CCatPathEnvironment"
					Name="PATH"
					Value="[INSTALLFOLDER64]"
					Action="set"
					Part="last"
					System="yes" />
